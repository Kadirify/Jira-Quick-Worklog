{
  "manifest_version": 3,
  "name": "Jira Quick Worklog",
  "version": "1.1.0",
  "description": "Jira worklog girişlerini uğraşmadan, tek tıkla yap. Günü tek taska ya da parça parça dağıt.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jira Quick Worklog",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background/main.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*"
  ]
}
